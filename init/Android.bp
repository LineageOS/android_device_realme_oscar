cc_library_static {
    name: "libinit_oscar",
    recovery_available: true,
    shared_libs: ["libbase"],
    srcs: ["init_oscar.cpp"],
}

prebuilt_etc {
    name: "init.device.rc",
    src: "init.device.rc",
    sub_dir: "init/hw",
    vendor: true,
}
